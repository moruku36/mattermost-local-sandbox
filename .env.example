# Mattermost origin (the host-side URL from your README is 3000 or 8065)
POSTGRES_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
MATTERMOST_URL=http://localhost:3000
MATTERMOST_BOT_TOKEN=

# Watch only the channels listed here. Use team-slug:channel-slug.
WATCH_CHANNELS=main-team:town-square,main-team:off-topic
DRAFTS_CHANNEL=main-team:ai-drafts

# Optional: monitor only explicitly listed direct/group DM channel IDs.
# The Bot must already be a member of each DM. Never add unrelated DM IDs.
# WATCH_DM_CHANNEL_IDS=id1,id2
# DM_LINK_TEAM=main-team

# Local Ollama; no message content leaves this machine.
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# OpenAI API (set LLM_PROVIDER=openai to use the cloud model instead)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=800

# Optional local file; personalize it without committing private details.
REPLY_PERSONA_FILE=data/reply-drafter-persona.txt

POLL_SECONDS=5
CONTEXT_POSTS=8
# Optional path for deduplication state. Stores post IDs only, not message text.
# STATE_FILE=data/reply-drafter-state.json

